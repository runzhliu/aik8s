    {
      "id": 17,
      "title": "etcd Proposal",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(otel_k8s_etcd_server_proposals_pending{telemetry_pipeline=\"otel-k8s-components\"})",
          "legendFormat": "pending",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(otel_k8s_etcd_server_proposals_failed_total{telemetry_pipeline=\"otel-k8s-components\"}[2m]))",
