      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,verb)(rate(otel_k8s_apiserver_request_duration_seconds_bucket{telemetry_pipeline=\"otel-k8s-components\",verb!~\"WATCH|CONNECT\"}[2m])))",
          "legendFormat": "{{verb}}",
