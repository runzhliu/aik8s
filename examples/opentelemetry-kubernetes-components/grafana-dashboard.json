      "title": "Pod 阶段",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(otel_k8s_k8s_pod_phase{telemetry_pipeline=\"otel-k8s-components\"} == 1)",
          "legendFormat": "Pending",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "count(otel_k8s_k8s_pod_phase{telemetry_pipeline=\"otel-k8s-components\"} == 2)",
          "legendFormat": "Running",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "count(otel_k8s_k8s_pod_phase{telemetry_pipeline=\"otel-k8s-components\"} == 4)",
          "legendFormat": "Failed",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "expr": "count(otel_k8s_k8s_pod_phase{telemetry_pipeline=\"otel-k8s-components\"} == 5)",
          "legendFormat": "Unknown",
          "range": true,
          "instant": false
