      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(envoy_response_code_class)(rate(envoy_http_downstream_rq_xx{job=\"aibrix-envoy\",envoy_http_conn_manager_prefix=\"http-10080\"}[$__rate_interval]))",
