  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope & metric contract",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Shared AIBrix controller.** These are cluster-wide reconcile/workqueue statistics, not isolated model request metrics. A healthy reconcile loop does not prove model readiness. Autoscaling, P/D separation and external distributed KV cache are not enabled in this experiment."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Controller scrape UP",
      "datasource": {
        "type": "prometheus",
        "uid": "aibrix-perf-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"aibrix-controller\"}",
          "legendFormat": "Controller",
          "datasource": {
            "type": "prometheus",
            "uid": "aibrix-perf-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reconcile rate by result",
      "datasource": {
        "type": "prometheus",
        "uid": "aibrix-perf-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(controller,result)(rate(controller_runtime_reconcile_total{job=\"aibrix-controller\"}[$__rate_interval]))",
          "legendFormat": "{{controller}} · {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aibrix-perf-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
