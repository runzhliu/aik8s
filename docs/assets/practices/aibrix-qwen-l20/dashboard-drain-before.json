{
  "uid": "qwen-l20-evidence-drain-before",
  "title": "Qwen L20 · 原配置退出：完整流",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "AIBrix",
    "Qwen3.8",
    "L20",
    "light"
  ],
  "style": "light",
  "timezone": "Asia/Shanghai",
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 2,
      "title": "完整流请求率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result)(rate(qwen_lab_requests_total{job=\"qwen-lab-client\",phase=~\"drain-native\"}[1m]))",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "客户端 TTFT P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
