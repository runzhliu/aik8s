          "refId": "A",
          "expr": "sum by(node_alias)(rate(vllm:generation_tokens_total{job=\"qwen-lab-engine\",model_name=\"qwen38-aibrix-lab\"}[1m]))",
          "legendFormat": "{{node_alias}}",
          "datasource": {
